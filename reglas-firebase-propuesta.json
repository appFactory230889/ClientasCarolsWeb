{
  "rules": {
    ".read": "auth != null && !auth.token.email.matches(/.*@(clientas|taller)\\.carols\\.app/)",
    ".write": "auth != null && !auth.token.email.matches(/.*@(clientas|taller)\\.carols\\.app/)",

    "TELAS": { ".read": "auth != null" },
    "COLORES": { ".read": "auth != null" },
    "CATALOGO": { ".read": "auth != null" },

    "TODOS LOS CLIENTES": {
      "CAROLS": {
        "$tel": {
          ".read": "auth != null && auth.token.email == $tel + '@clientas.carols.app'"
        }
      }
    },

    "PEDIDOS": {
      "$tel": {
        ".read": "auth != null && auth.token.email == $tel + '@clientas.carols.app'",
        "$pedido": {
          "$nodo": {
            ".write": "auth != null && auth.token.email == $tel + '@clientas.carols.app' && !data.exists()"
          }
        }
      }
    },

    "VENTAS GLOBALES": {
      "Pedidos Carol´s": {
        ".indexOn": ["fechaDeRecepcion"],
        "$codigo": {
          ".write": "auth != null && !data.exists() && newData.child('codigoDeCliente').exists() && auth.token.email == newData.child('codigoDeCliente').val() + '@clientas.carols.app'"
        }
      },
      "Pedidos de Vendedoras": { ".indexOn": ["fechaDeRecepcion"] }
    },

    "ASISTENCIA": {
      "$tel": {
        ".read": "auth != null && auth.token.email == $tel + '@taller.carols.app'",
        "$dia": {
          ".write": "auth != null && auth.token.email == $tel + '@taller.carols.app' && !data.child('pagado').exists()"
        }
      }
    },

    "RRHH": {
      "Configuracion": { ".read": "auth != null" }
    }
  }
}
