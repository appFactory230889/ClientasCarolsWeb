{
  "rules": {
    ".read": "auth != null && root.child('STAFF').child(auth.uid).val() === true",
    ".write": "auth != null && root.child('STAFF').child(auth.uid).val() === true",

    "CLIENTAS_WEB": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "TELAS": { ".read": "auth != null && root.child('CLIENTAS_WEB').child(auth.uid).exists()" },
    "COLORES": { ".read": "auth != null && root.child('CLIENTAS_WEB').child(auth.uid).exists()" },
    "CATALOGO": { ".read": "auth != null && root.child('CLIENTAS_WEB').child(auth.uid).exists()" },

    "TODOS LOS CLIENTES": {
      "CAROLS": {
        "$tel": {
          ".read": "auth != null && root.child('CLIENTAS_WEB').child(auth.uid).val() === $tel"
        }
      }
    },

    "PEDIDOS": {
      "$tel": {
        ".read": "auth != null && root.child('CLIENTAS_WEB').child(auth.uid).val() === $tel",

        "mis pedidos": {
          "$pedido": {
            ".write": "auth != null && root.child('CLIENTAS_WEB').child(auth.uid).val() === $tel && (!data.exists() || data.child('estatus').val() === 'abierto')"
          }
        },

        "$pedido": {
          "$nodo": {
            ".write": "auth != null && root.child('CLIENTAS_WEB').child(auth.uid).val() === $tel && newData.parent().parent().child('mis pedidos').child($pedido).child('estatus').val() === 'abierto'"
          }
        }
      }
    },

    "VENTAS GLOBALES": {
      "Pedidos Carol´s": {
        ".indexOn": ["fechaDeRecepcion"],
        "$codigo": {
          ".write": "auth != null && !data.exists() && newData.child('codigoDeCliente').exists() && root.child('CLIENTAS_WEB').child(auth.uid).val() === newData.child('codigoDeCliente').val()"
        }
      },
      "Pedidos de Vendedoras": { ".indexOn": ["fechaDeRecepcion"] }
    }
  }
}
