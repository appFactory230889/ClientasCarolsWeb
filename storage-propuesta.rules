rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Storage NO puede consultar la Realtime Database (no ve CLIENTAS_WEB ni STAFF), así que el personal se
    // identifica por su correo. Escriba aquí los correos con los que entra al ERP, a Carol's 5.0 y a la app de
    // vendedoras (en minúsculas).
    function esPersonal() {
      return request.auth != null
          && request.auth.token.email in ['CORREO_DE_LA_ADMINISTRADORA@gmail.com'];
    }

    // Las clientas solo SUBEN fotos de sus pedidos: imagen y máximo 5 MB. Verlas funciona por el enlace con
    // token que guarda cada pedido (no depende de estas reglas).
    match /Fotos Subidas/{archivo} {
      allow create: if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow read, update, delete: if esPersonal();
    }

    // Todo lo demás (comprobantes de finanzas, facturas, logos...): solo el personal.
    match /{allPaths=**} {
      allow read, write: if esPersonal();
    }
  }
}
